# ── ManfacterCAD ──
# Copia este archivo como .env y rellena tus valores.
# Para desarrollo local: no hace falta .env, los defaults ya apuntan a 127.0.0.1

# ── Backend (Python servers) ──
# Host al que se bindean los 3 servidores. "127.0.0.1" para local, "0.0.0.0" para VPS
BACKEND_HOST=127.0.0.1

# Puertos (solo cambiar si hay conflictos)
# BACKEND_PORT=8000
# GEMINI_AGENT_PORT=8002
# OPENAI_AGENT_PORT=8003

# ── API Keys (obligatorias) ──
GOOGLE_GENERATIVE_AI_API_KEY=
OPENCODE_API_KEY=
OPENAI_API_KEY=

# ── Frontend (Next.js) ──
# Desarrollo local: NEXT_PUBLIC_BACKEND_HOST=127.0.0.1 (por defecto si no se define)
# VPS con nginx proxy: NEXT_PUBLIC_PROXY=true
# NEXT_PUBLIC_BACKEND_HOST=127.0.0.1
# NEXT_PUBLIC_PROXY=

# ── ForgeCAD (TypeScript engine) ──
CAD_ENGINE=manifold
NEXT_PUBLIC_CAD_WS_URL=ws://localhost:3000/api/cad/ws
NEXT_PUBLIC_CAD_REST_URL=http://localhost:3000/api/generate

# ── Feature flags: optimize-cad-perf (default "true") ──
# Cada flag se lee en cada request, así que se puede alternar sin reiniciar.
# EPIC_A_ENABLED: prompt + clasificador de tier + bloque GOTCHAS. "false" → MODERATE fijo y sin GOTCHAS.
# EPIC_B_ENABLED: malla única + STL/GLB en paralelo + caché GLB. "false" → ruta dual-mesh.
# EPIC_C_ENABLED: guardrails, model_id session map, validación dimensional. "false" → mantiene `code` y respuesta inspect completa.
# EPIC_A_ENABLED=true
# EPIC_B_ENABLED=true
# EPIC_C_ENABLED=true
